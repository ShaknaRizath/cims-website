// Prisma schema for the CIMS marketing website (www.cims.lk) — a separate
// project/database from the CIMS Campus LMS. Kept deliberately minimal: no
// LMS-style multi-role RBAC or audit trails, since this only backs public
// marketing content plus a single admin CMS role.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum AdminRole {
  ADMIN
  ADMISSIONS_OFFICER
}

enum TeamCategory {
  BOARD_OF_GOVERNORS
  ACADEMIC_BOARD
  INTERNATIONAL_REPRESENTATIVE
}

enum PostKind {
  NEWS
  ANNOUNCEMENT
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

// ---------- AUTH ----------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // Single role today; kept as an enum so a future EDITOR-tier role is an
  // enum addition, not a schema rethink.
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// ---------- CONTENT ----------

model Programme {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  categoryId        String
  category          ProgrammeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  level             String? // "Bachelor's Degree", "Higher Diploma", "Foundation"
  durationText      String? // "3 Years", "18 Months"
  summary           String            @db.Text // card/listing blurb
  description       String            @db.Text // sanitized HTML, detail page body
  entryRequirements String?           @db.Text
  careerOutcomes    String?           @db.Text
  highlights        Json? // string[] bullet points — avoids a child table for a few bullets
  heroImageUrl      String?
  brochureFileUrl   String? // PDF
  isFeatured        Boolean           @default(false)
  isPublished       Boolean           @default(true)
  orderIndex        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  testimonials Testimonial[]
  applications Application[]

  @@index([categoryId, isPublished])
}

// Admin-managed lookup table (replaces what used to be a fixed enum) so
// categories can be added/renamed/deleted from the CMS instead of code.
model ProgrammeCategory {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  orderIndex Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  programmes Programme[]

  @@index([orderIndex])
}

model NewsPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  kind          PostKind @default(NEWS)
  title         String
  excerpt       String?
  bodyHtml      String   @db.Text // sanitized via sanitize-html, same as LMS convention
  coverImageUrl String?
  isPinned      Boolean  @default(false) // announcements only, in practice
  isPublished   Boolean  @default(true)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind, isPublished, publishedAt])
}

model Event {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String?   @db.Text
  location      String?
  startAt       DateTime
  endAt         DateTime?
  coverImageUrl String? // full poster/photo, shown uncropped on the event's own page
  // Deliberately cropped 16:9 version of coverImageUrl for the Events listing card —
  // falls back to coverImageUrl (browser-cropped via object-cover) when not set.
  cardImageUrl  String?
  isFeatured    Boolean   @default(false)
  isPublished   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([startAt])
}

model Testimonial {
  id          String      @id @default(cuid())
  studentName String
  photoUrl    String?
  batchYear   Int?
  programmeId String?
  programme   Programme?  @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  // Free-text fallback for when the programme this quote refers to isn't (or
  // isn't yet) a real Programme record — takes display priority over the
  // linked programme's name when set.
  programmeName String?
  quote       String      @db.Text
  videoUrl    String? // optional video testimonial link (YouTube etc.)
  isFeatured  Boolean     @default(false) // shown in homepage/success-stories carousel
  isPublished Boolean     @default(true)
  orderIndex  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isFeatured, isPublished])
}

model TeamMember {
  id          String       @id @default(cuid())
  name        String
  category    TeamCategory
  title       String // position/role text
  bio         String?      @db.Text
  photoUrl    String?
  orderIndex  Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category, isPublished])
}

model HeroSlide {
  id          String   @id @default(cuid())
  imageUrl    String
  orderIndex  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model PartnerUniversity {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  orderIndex  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model CampusLocation {
  id           String   @id @default(cuid())
  name         String   @unique
  addressLine1 String
  addressLine2 String?
  city         String
  phone        String?
  email        String?
  mapEmbedUrl  String? // Google Maps embed iframe src
  photoUrl     String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  mobile    String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// Public online application submitted through /apply. Deliberately excludes
// batch/fee-plan/payment fields — those are handled later in the enrolment
// process, outside this initial form.
model Application {
  id                        String            @id @default(cuid())
  fullName                  String
  nameWithInitials          String
  dateOfBirth               DateTime
  gender                    String // "MALE" | "FEMALE"
  nicOrPassport              String
  email                      String
  mobileNumber               String
  address                    String            @db.Text
  nationality                String
  programmeId                String
  programme                  Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  highestQualification       String
  institution                 String
  yearCompleted               Int?
  additionalQualifications   String?           @db.Text
  status                      ApplicationStatus @default(SUBMITTED)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  documents ApplicationDocument[]

  @@index([status, createdAt])
  @@index([programmeId])
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Slot key: "NIC_PASSPORT" | "PHOTO" | "CERTIFICATE" | "TRANSCRIPT" | "OTHER"
  documentType  String
  fileUrl       String
  fileName      String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// Singleton row — same "one enforced-in-code active row" spirit as the LMS's
// AcademicYear.isActive pattern, but simpler: id is always the literal
// string "singleton", enforced via upsert in the settings action, never via
// app-level create.
model SiteSettings {
  id                  String   @id @default("singleton")
  // Site brand mark shown in the header next to "CIMS Campus" — separate from
  // the favicon/other marketing images, since it's used in site chrome, not content.
  logoUrl             String?
  heroHeadline        String
  heroSubheadline     String?
  aboutSummary        String?  @db.Text
  chairmanMessageHtml String?  @db.Text
  chairmanPhotoUrl    String?
  ourRole             String?  @db.Text
  ourVision           String?  @db.Text
  ourMission          String?  @db.Text
  aboutTeaserImageUrl String?
  // Background image behind the navy hero banner on the About Us page —
  // separate from aboutTeaserImageUrl, which is the smaller homepage teaser photo.
  aboutHeroImageUrl   String?
  contactPhone        String
  contactEmail        String
  contactAddress      String
  whatsappNumber      String?
  facebookUrl         String?
  instagramUrl        String?
  linkedinUrl         String?
  youtubeUrl          String?
  tiktokUrl           String?
  lmsUrl              String // e.g. https://lms.cims.lk — "Online Learning Portal"
  certificateVerifyUrl String // e.g. https://lms.cims.lk/verify
  onlinePaymentUrl    String // e.g. https://lms.cims.lk/login?callbackUrl=/student/payments
  updatedAt           DateTime @updatedAt
}
